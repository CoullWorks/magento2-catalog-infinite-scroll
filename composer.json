{
    "name": "coullworks/module-catalog-infinite-scroll",
    "description": "CoullWorks Catalog Infinite Scroll for Magento 2 — AJAX infinite scroll / load-more for category, search, Page Builder, CMS and widget product lists, with optional masonry, isotope and packery layouts.",
    "type": "magento2-module",
    "license": "MIT",
    "authors": [
        {
            "name": "danrcoull",
            "email": "ttechitsolutions@gmail.com",
            "homepage": "https://coullworks.com"
        }
    ],
    "homepage": "https://github.com/CoullWorks/magento2-catalog-infinite-scroll",
    "support": {
        "issues": "https://github.com/CoullWorks/magento2-catalog-infinite-scroll/issues",
        "source": "https://github.com/CoullWorks/magento2-catalog-infinite-scroll"
    },
    "require": {
        "php": "~8.2.0 || ~8.3.0 || ~8.4.0",
        "ext-json": "*",
        "magento/framework": ">=103.0.0"
    },
    "require-dev": {
        "magento/magento-coding-standard": ">=32",
        "phpunit/phpunit": "^10.5 || ^11.0"
    },
    "autoload": {
        "files": [
            "registration.php"
        ],
        "psr-4": {
            "CoullWorks\\CatalogInfiniteScroll\\": ""
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CoullWorks\\CatalogInfiniteScroll\\Test\\": "Test/"
        }
    }
}
