<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="content">
            <block class="CoullWorks\CatalogInfiniteScroll\Block\Scroll"
                   ifconfig="catalog_infinite_scroll/general/enable"
                   name="coullworks.infinite.scroll"
                   template="CoullWorks_CatalogInfiniteScroll::scroll.phtml"
                   after="search.result"/>
        </referenceContainer>
    </body>
</page>
